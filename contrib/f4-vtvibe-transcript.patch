--- /dev/null
+++ b/internal/vtvibe/transcript_test.go
@@ -0,0 +1,168 @@
+package vtvibe
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/unxed/f4/vfs"
+)
+
+func exportTranscript(t *testing.T, s *Session) (transcriptBundle, string) {
+	t.Helper()
+	v := NewVFS(s)
+	r, err := v.Open(context.Background(), "ai://agendrain.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+	data := make([]byte, r.Size())
+	if _, err := r.ReadAt(context.Background(), data, 0); err != nil {
+		t.Fatal(err)
+	}
+	var b transcriptBundle
+	if err := json.Unmarshal(data, &b); err != nil {
+		t.Fatal(err)
+	}
+	if b.Version != 1 || len(b.Sessions) != 1 {
+		t.Fatalf("invalid bundle: %s", data)
+	}
+	text := string(data)
+	for _, e := range b.Sessions[0].Events {
+		for _, bl := range e.Blocks {
+			text += "\n" + bl.Text
+		}
+	}
+	return b, text
+}
+
+func TestTranscriptCapturesHistoricalPromptsAndReferences(t *testing.T) {
+	srv, _ := sseServer(t, `data: {"choices":[{"delta":{"content":"recorded answer"}}]}`, `data: [DONE]`)
+	s := NewSession()
+	s.SetPatchMode(true)
+	_, _ = s.AddContextFile("gone.txt", []byte("PRIVATE LOCAL FILE BODY"))
+	cfg := Config{BaseURL: srv.URL, APIKey: "SECRET API KEY", System: "original base prompt", Model: "original-model"}
+	if err := s.Ask(context.Background(), cfg, "original question"); err != nil {
+		t.Fatal(err)
+	}
+	if err := NewVFS(s).Remove(context.Background(), "/ctx/gone.txt"); err != nil {
+		t.Fatal(err)
+	}
+	s.SetPatchMode(false)
+	s.SetStatus(Status{Model: "later-model", KeySource: "SECRET API KEY"})
+	b, text := exportTranscript(t, s)
+	for _, want := range []string{"original base prompt", PatchModePrompt, "ctx/gone.txt", "original question", "recorded answer", "original-model"} {
+		if !strings.Contains(text, want) {
+			t.Errorf("missing %q", want)
+		}
+	}
+	for _, forbidden := range []string{"PRIVATE LOCAL FILE BODY", "SECRET API KEY", "later-model"} {
+		if strings.Contains(text, forbidden) {
+			t.Errorf("leaked %q", forbidden)
+		}
+	}
+	var roles []string
+	for _, e := range b.Sessions[0].Events {
+		if e.Role == "user" || e.Role == "assistant" {
+			roles = append(roles, e.Role)
+		}
+	}
+	if strings.Join(roles, ",") != "user,assistant" {
+		t.Fatalf("message order %v", roles)
+	}
+	if strings.Contains(s.Pack(), "agendrain") {
+		t.Fatal("export was packed into context")
+	}
+}
+
+func TestTranscriptFailedRequestsPersistAndReset(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { http.Error(w, "no access", http.StatusUnauthorized) }))
+	defer srv.Close()
+	s := NewSession()
+	store := filepath.Join(t.TempDir(), "dialog.json")
+	if err := s.SetStorePath(store); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.Ask(context.Background(), Config{BaseURL: srv.URL, APIKey: "k", Model: "m", System: "failed prompt"}, "failed question"); err == nil {
+		t.Fatal("expected failure")
+	}
+	restored := NewSession()
+	if err := restored.SetStorePath(store); err != nil {
+		t.Fatal(err)
+	}
+	_, text := exportTranscript(t, restored)
+	for _, want := range []string{"failed prompt", "failed question", "failed"} {
+		if !strings.Contains(text, want) {
+			t.Errorf("missing %q", want)
+		}
+	}
+	restored.Reset(false)
+	_, text = exportTranscript(t, restored)
+	if strings.Contains(text, "failed question") {
+		t.Fatal("reset retained request history")
+	}
+}
+
+func TestTranscriptIsListedAndReadOnly(t *testing.T) {
+	v := NewVFS(NewSession())
+	ctx := context.Background()
+	listed := false
+	if err := v.ReadDir(ctx, "/", func(items []vfs.VFSItem) {
+		for _, item := range items {
+			if item.Name == "agendrain.json" {
+				listed = true
+			}
+		}
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if !listed {
+		t.Fatal("export not listed")
+	}
+	if _, err := v.Stat(ctx, "ai://agendrain.json"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := v.Create(ctx, "ai://agendrain.json"); !errors.Is(err, os.ErrPermission) {
+		t.Fatalf("Create error %v", err)
+	}
+	if err := v.MkDir(ctx, "ai://agendrain.json"); !errors.Is(err, os.ErrPermission) {
+		t.Fatalf("MkDir error %v", err)
+	}
+	if err := v.Remove(ctx, "ai://agendrain.json"); !errors.Is(err, os.ErrPermission) {
+		t.Fatalf("Remove error %v", err)
+	}
+	if err := v.Rename(ctx, "ai://agendrain.json", "/ctx/leak"); !errors.Is(err, os.ErrPermission) {
+		t.Fatalf("Rename error %v", err)
+	}
+}
+
+func TestTranscriptLargeExportDoesNotUseContextBudget(t *testing.T) {
+	s := NewSession()
+	large := strings.Repeat("x", maxFileBytes+1)
+	s.Note("assistant", large)
+	_, text := exportTranscript(t, s)
+	if !strings.Contains(text, large) {
+		t.Fatal("large export lost dialog text")
+	}
+	if _, exists := s.tree.stat(transcriptFile); exists {
+		t.Fatal("export occupies bounded context tree")
+	}
+}
+
+func TestTranscriptOldDialogWarnsWithoutInventingInstructions(t *testing.T) {
+	s := NewSession()
+	s.Note("user", "legacy question")
+	_, text := exportTranscript(t, s)
+	if !strings.Contains(text, "cannot be reconstructed") {
+		t.Fatal("missing historical instruction warning")
+	}
+	if strings.Contains(text, DefaultSystemPrompt) {
+		t.Fatal("invented a historical system prompt")
+	}
+}
