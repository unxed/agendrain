diff --git a/internal/vtvibe/transcript.go b/internal/vtvibe/transcript.go
new file mode 100644
index 00000000..5d89b598
--- /dev/null
+++ b/internal/vtvibe/transcript.go
@@ -0,0 +1,158 @@
+package vtvibe
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"time"
+)
+
+const transcriptFile = "/agendrain.json"
+
+// requestRecord stores instructions at send time. Packed local file contents
+// and provider credentials deliberately never enter this record. BeforeTurn
+// places attempts among the retained turns, including attempts that failed.
+type requestRecord struct {
+	BeforeTurn   int       `json:"before_turn"`
+	Time         time.Time `json:"time"`
+	Model        string    `json:"model,omitempty"`
+	System       string    `json:"system"`
+	Question     string    `json:"question"`
+	Context      []string  `json:"context,omitempty"`
+	CompactLevel int       `json:"compact_level,omitempty"`
+	Outcome      string    `json:"outcome"`
+}
+
+// These types mirror agendrain's portable version 1 schema without adding a
+// runtime dependency. File references are relative to a copied ai:// root.
+type transcriptBundle struct {
+	Version  int                 `json:"version"`
+	Sessions []transcriptSession `json:"sessions"`
+	Warnings []string            `json:"warnings,omitempty"`
+}
+type transcriptSession struct {
+	ID     string            `json:"id"`
+	Source string            `json:"source"`
+	Title  string            `json:"title,omitempty"`
+	Models []string          `json:"models,omitempty"`
+	Events []transcriptEvent `json:"events"`
+}
+type transcriptEvent struct {
+	Time   string            `json:"time,omitempty"`
+	Role   string            `json:"role"`
+	Kind   string            `json:"kind,omitempty"`
+	Blocks []transcriptBlock `json:"blocks"`
+}
+type transcriptBlock struct {
+	Type        string `json:"type"`
+	Text        string `json:"text,omitempty"`
+	Path        string `json:"path,omitempty"`
+	Description string `json:"description,omitempty"`
+}
+
+func (s *Session) recordRequest(system, question, model string, level int, keep func(string) bool) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	r := requestRecord{BeforeTurn: len(s.turns), Time: time.Now(), Model: model,
+		System: system, Question: question, CompactLevel: level, Outcome: "pending"}
+	for _, p := range s.tree.walkFiles(ctxDir) {
+		rel := strings.TrimPrefix(p, ctxDir+"/")
+		if !looksSecret(rel) && (keep == nil || keep(rel)) {
+			r.Context = append(r.Context, strings.TrimPrefix(p, "/"))
+		}
+	}
+	s.requests = append(s.requests, r)
+	s.saveLocked()
+	return len(s.requests) - 1
+}
+
+func (s *Session) finishRequest(index int, err error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	// A reset may have discarded an in-flight request.
+	if index < 0 || index >= len(s.requests) {
+		return
+	}
+	s.requests[index].Outcome = "succeeded"
+	if err != nil {
+		s.requests[index].Outcome = "failed"
+	}
+	s.saveLocked()
+}
+
+// transcript builds a read-only F5 export outside the bounded context tree.
+// Old dialogs have no prompt snapshots; do not replace that missing evidence
+// with today's configured prompt. JSON encoding these string-only fields cannot fail.
+func (s *Session) transcript() []byte {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	session := transcriptSession{ID: "vtvibe", Source: "vtvibe", Title: s.title, Events: []transcriptEvent{}}
+	add := func(role, kind, text string, when time.Time) {
+		stamp := ""
+		if !when.IsZero() {
+			stamp = when.UTC().Format(time.RFC3339Nano)
+		}
+		session.Events = append(session.Events, transcriptEvent{Role: role, Kind: kind, Time: stamp,
+			Blocks: []transcriptBlock{{Type: "text", Text: text}}})
+	}
+	request := func(r requestRecord) {
+		if r.Model != "" {
+			found := false
+			for _, m := range session.Models {
+				if m == r.Model {
+					found = true
+					break
+				}
+			}
+			if !found {
+				session.Models = append(session.Models, r.Model)
+			}
+		}
+		add("system", "instructions", r.System, r.Time)
+		if len(r.Context) > 0 {
+			e := transcriptEvent{Role: "system", Kind: "context", Time: r.Time.UTC().Format(time.RFC3339Nano), Blocks: []transcriptBlock{}}
+			for _, p := range r.Context {
+				e.Blocks = append(e.Blocks, transcriptBlock{Type: "file", Path: p, Description: "Attached context file; contents excluded from transcript"})
+			}
+			session.Events = append(session.Events, e)
+		}
+		if r.Outcome != "succeeded" || r.BeforeTurn >= len(s.turns) || s.turns[r.BeforeTurn].Role != "user" || s.turns[r.BeforeTurn].Text != r.Question {
+			add("user", "request", r.Question, r.Time)
+		}
+		add("system", "request_outcome", fmt.Sprintf("Request %s; history compaction level %d", r.Outcome, r.CompactLevel), r.Time)
+	}
+	attempts := make(map[int][]requestRecord)
+	for _, r := range s.requests {
+		attempts[r.BeforeTurn] = append(attempts[r.BeforeTurn], r)
+	}
+	for i := 0; i <= len(s.turns); i++ {
+		for _, r := range attempts[i] {
+			request(r)
+		}
+		if i < len(s.turns) {
+			t := s.turns[i]
+			role := t.Role
+			if role == "model" {
+				role = "system"
+			} // panel hint, not a model reply
+			add(role, "message", t.Text, t.Time)
+		}
+	}
+	// Files copied in after the last request are still useful references.
+	if files := s.tree.walkFiles(ctxDir); len(files) > 0 {
+		e := transcriptEvent{Role: "system", Kind: "current_context", Blocks: []transcriptBlock{}}
+		for _, p := range files {
+			e.Blocks = append(e.Blocks, transcriptBlock{Type: "file", Path: strings.TrimPrefix(p, "/"), Description: "Current context file; contents excluded from transcript"})
+		}
+		session.Events = append(session.Events, e)
+	}
+	b := transcriptBundle{Version: 1, Sessions: []transcriptSession{session}, Warnings: []string{
+		"Only Session dialog turns and captured request instructions are exported. Transient bot, manager, worker and tool-call histories are not retained by this session.",
+		"Packed file contents, image bytes, credentials and raw provider errors are excluded. Context references may refer to files removed since the request.",
+	}}
+	if len(s.requests) == 0 || (len(s.requests) > 0 && s.requests[0].BeforeTurn > 1) {
+		b.Warnings = append(b.Warnings, "Historical instructions before request recording began were not saved and cannot be reconstructed.")
+	}
+	data, _ := json.MarshalIndent(b, "", "  ")
+	return append(data, '\n')
+}
diff --git a/internal/vtvibe/transcript_test.go b/internal/vtvibe/transcript_test.go
new file mode 100644
